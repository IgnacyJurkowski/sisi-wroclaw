---
/*
 * Particles — the site's backdrop: a field of soft cream/gold circles suspended
 * in the wine, like motes of light in a dark club. Pure CSS, no JS, no library.
 * It sits fixed behind everything (z-index:-1) and shows through every
 * transparent section below the hero, so the page never reads as flat wine.
 *
 * Each layer is a seamless SVG tile, generated here at build time by a seeded
 * RNG (so the field is identical on every page and reproducible build-to-build)
 * and repeated across the viewport.
 *
 * THE FIELD DOES NOT MOVE, and that is the whole point of its shape. A
 * full-window layer that animates costs a full-window redraw every frame for as
 * long as the page is open, and the browser pays that bill once per animated
 * layer. Eight of them made the site unusable on a desktop while a phone
 * shrugged it off, because the cost scales with the window. Measured on the
 * built site (Chromium, software rasteriser, home page, no scrolling):
 *
 *     window        eight drifting layers      still
 *     390x844               60 fps            60 fps
 *     1440x900              15 fps            60 fps
 *     1920x1080             12 fps            60 fps
 *     2560x1440              6 fps            60 fps
 *     3840x2160            4.3 fps            60 fps
 *
 * The animated property makes no difference: one layer costs the same ~50 ms a
 * frame at 1440p whether it animates transform or opacity. There is no cheap
 * way to animate a plate this size, and no amount of tuning the texture helps —
 * pre-rasterising the tiles to PNG, dropping the tile size, adding or removing
 * will-change and contain, and stepping the animation were all measured and all
 * changed nothing. Two earlier attempts at this backdrop (a box-shadow
 * starfield, then these tiles drifting) each cut the constant and left the
 * shape, so the site still lagged.
 *
 * Standing still, the eight tiles paint once into the page's own layer and are
 * never touched again: no promoted layers, no compositor texture, and every
 * page holds 60 fps up to 4K with the glass panels intact.
 *
 * When motion comes back it has to come from a small number of small boxes, not
 * from these plates. html.bg-live (added after load + idle by Base.astro) stays
 * in place as the gate for it.
 */
type Rand = () => number;
function rng(seed: number): Rand {
  return function () {
    seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

/** The old field's area — every layer's density is still quoted against it, so
    the tiles carry the same number of circles per pixel as the original. */
const SOURCE_AREA = 2560 * 2000;

type Layer = {
  key: string;
  /** circles the original field scattered over SOURCE_AREA */
  count: number;
  /** circle radius in px */
  r: number;
  colors: string[];
  /** soft-edged (the glowing orbs and bokeh) rather than a crisp dot */
  soft?: boolean;
  /** tile edge in px; larger tiles repeat less visibly for sparse layers */
  tile: number;
};

const LAYERS: Layer[] = [
  { key: 'lg',  count: 14,  r: 10,  tile: 1200, soft: true, colors: ['rgba(245,232,213,0.13)', 'rgba(251,210,149,0.11)'] },
  { key: 'orb', count: 26,  r: 6,   tile: 1200, soft: true, colors: ['rgba(251,210,149,0.20)', 'rgba(237,219,194,0.18)'] },
  { key: 'bg',  count: 40,  r: 2,   tile: 800,  colors: ['rgba(237,219,194,0.85)', 'rgba(245,232,213,0.7)'] },
  { key: 'md',  count: 90,  r: 1.5, tile: 800,  colors: ['rgba(251,210,149,0.7)', 'rgba(245,232,213,0.6)'] },
  { key: 'sm',  count: 200, r: 1,   tile: 800,  colors: ['rgba(237,219,194,0.85)', 'rgba(245,232,213,0.7)'] },
  { key: 'spA', count: 26,  r: 1,   tile: 800,  colors: ['rgba(255,250,242,0.95)', 'rgba(255,243,214,0.92)'] },
  { key: 'spB', count: 22,  r: 1,   tile: 800,  colors: ['rgba(255,238,205,0.95)', 'rgba(255,250,242,0.9)'] },
  { key: 'dn',  count: 34,  r: 1,   tile: 800,  colors: ['rgba(237,219,194,0.85)', 'rgba(245,232,213,0.7)'] },
];

/** One seamless tile as an SVG data URI. Circles within a radius of an edge are
    drawn again on the opposite side, so the repeat has no visible seam. */
function tileUri(rand: Rand, layer: Layer): string {
  const { tile, r, colors, soft } = layer;
  const n = Math.max(2, Math.round((layer.count * tile * tile) / SOURCE_AREA));
  const body: string[] = [];
  const gradients = new Set<number>();

  for (let i = 0; i < n; i++) {
    const x = Math.round(rand() * tile);
    const y = Math.round(rand() * tile);
    const ci = Math.floor(rand() * colors.length);
    if (soft) gradients.add(ci);
    for (const dx of x < r ? [0, tile] : x > tile - r ? [0, -tile] : [0]) {
      for (const dy of y < r ? [0, tile] : y > tile - r ? [0, -tile] : [0]) {
        const fill = soft ? `url(#g${ci})` : colors[ci];
        body.push(`<circle cx="${x + dx}" cy="${y + dy}" r="${r}" fill="${fill}"/>`);
      }
    }
  }

  // Soft layers fade to transparent instead of carrying a blur filter: a filter
  // would have to be re-rasterized, a gradient is baked into the tile once.
  const defs = [...gradients]
    .map((ci) => `<radialGradient id="g${ci}"><stop offset="0" stop-color="${colors[ci]}"/><stop offset="1" stop-color="${colors[ci].replace(/[\d.]+\)$/, '0)')}"/></radialGradient>`)
    .join('');

  const svg =
    `<svg xmlns="http://www.w3.org/2000/svg" width="${tile}" height="${tile}" viewBox="0 0 ${tile} ${tile}">` +
    (defs ? `<defs>${defs}</defs>` : '') +
    body.join('') +
    '</svg>';
  return `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
}

const r = rng(20260625);
const tiles = Object.fromEntries(LAYERS.map((layer) => [layer.key, tileUri(r, layer)]));
const vars = LAYERS.map((l) => `--img-${l.key}:${tiles[l.key]}; --t-${l.key}:${l.tile}px`).join('; ');
---

<div class="circles" aria-hidden="true" style={vars}>
  {LAYERS.map((layer) => <div class:list={['cir', layer.key]} />)}
</div>

<style>
  .circles {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    /* a touch of depth: warm glow up top, pooled shadow at the floor */
    background:
      radial-gradient(ellipse 120% 80% at 50% 120%, rgba(61, 19, 32, 0.55) 0%, rgba(0, 0, 0, 0) 60%),
      radial-gradient(ellipse at 50% -10%, rgba(140, 36, 52, 0.18) 0%, rgba(0, 0, 0, 0) 45%),
      var(--bg);
  }

  /* Each layer is exactly the viewport and repeats its own tile. Nothing here
     animates, so all eight paint once into the page's own layer: the compositor
     holds no texture for the backdrop and does no per-frame work for it. If you
     ever attach an animation to .cir, read the table above first - it puts a
     full-window layer back on the compositor and the desktop cost comes back
     with it. */
  .cir {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-repeat: repeat;
  }
  .cir.lg  { background-image: var(--img-lg);  background-size: var(--t-lg) var(--t-lg); }
  .cir.orb { background-image: var(--img-orb); background-size: var(--t-orb) var(--t-orb); }
  .cir.bg  { background-image: var(--img-bg);  background-size: var(--t-bg) var(--t-bg); }
  .cir.md  { background-image: var(--img-md);  background-size: var(--t-md) var(--t-md); }
  .cir.sm  { background-image: var(--img-sm);  background-size: var(--t-sm) var(--t-sm); }
  .cir.spA { background-image: var(--img-spA); background-size: var(--t-spA) var(--t-spA); }
  .cir.spB { background-image: var(--img-spB); background-size: var(--t-spB) var(--t-spB); }
  .cir.dn  { background-image: var(--img-dn);  background-size: var(--t-dn) var(--t-dn); }
</style>
