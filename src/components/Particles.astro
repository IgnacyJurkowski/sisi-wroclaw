---
/*
 * Cream and gold circles drifting through the wine backdrop. The seeded SVG
 * tiles keep the original field's palette, density and soft bokeh reproducible
 * across pages. Transform carries each tile through one seamless repeat;
 * staggered opacity cycles add a gentle shimmer without animated filters.
 *
 * Motion starts paused. Base.astro owns html.bg-live, including its post-load
 * start, visibility handling and the visitor's pause choice. Removing that
 * class pauses the current frame, so resuming does not reset the field.
 * Reduced-motion visitors keep the still backdrop.
 */
type Rand = () => number;
function rng(seed: number): Rand {
  return function () {
    seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

/** The old field's area — every layer's density is still quoted against it, so
    the tiles carry the same number of circles per pixel as the original. */
const SOURCE_AREA = 2560 * 2000;

type Layer = {
  key: string;
  /** circles the original field scattered over SOURCE_AREA */
  count: number;
  /** circle radius in px */
  r: number;
  colors: string[];
  /** soft-edged (the glowing orbs and bokeh) rather than a crisp dot */
  soft?: boolean;
  /** tile edge in px; larger tiles repeat less visibly for sparse layers */
  tile: number;
};

const LAYERS: Layer[] = [
  { key: 'lg',  count: 14,  r: 10,  tile: 1200, soft: true, colors: ['rgba(245,232,213,0.13)', 'rgba(251,210,149,0.11)'] },
  { key: 'orb', count: 26,  r: 6,   tile: 1200, soft: true, colors: ['rgba(251,210,149,0.20)', 'rgba(237,219,194,0.18)'] },
  { key: 'bg',  count: 40,  r: 2,   tile: 800,  colors: ['rgba(237,219,194,0.85)', 'rgba(245,232,213,0.7)'] },
  { key: 'md',  count: 90,  r: 1.5, tile: 800,  colors: ['rgba(251,210,149,0.7)', 'rgba(245,232,213,0.6)'] },
  { key: 'sm',  count: 200, r: 1,   tile: 800,  colors: ['rgba(237,219,194,0.85)', 'rgba(245,232,213,0.7)'] },
  { key: 'spA', count: 26,  r: 1,   tile: 800,  colors: ['rgba(255,250,242,0.95)', 'rgba(255,243,214,0.92)'] },
  { key: 'spB', count: 22,  r: 1,   tile: 800,  colors: ['rgba(255,238,205,0.95)', 'rgba(255,250,242,0.9)'] },
  { key: 'dn',  count: 34,  r: 1,   tile: 800,  colors: ['rgba(237,219,194,0.85)', 'rgba(245,232,213,0.7)'] },
];

/** One seamless tile as an SVG data URI. Circles within a radius of an edge are
    drawn again on the opposite side, so the repeat has no visible seam. */
function tileUri(rand: Rand, layer: Layer): string {
  const { tile, r, colors, soft } = layer;
  const n = Math.max(2, Math.round((layer.count * tile * tile) / SOURCE_AREA));
  const body: string[] = [];
  const gradients = new Set<number>();

  for (let i = 0; i < n; i++) {
    const x = Math.round(rand() * tile);
    const y = Math.round(rand() * tile);
    const ci = Math.floor(rand() * colors.length);
    if (soft) gradients.add(ci);
    for (const dx of x < r ? [0, tile] : x > tile - r ? [0, -tile] : [0]) {
      for (const dy of y < r ? [0, tile] : y > tile - r ? [0, -tile] : [0]) {
        const fill = soft ? `url(#g${ci})` : colors[ci];
        body.push(`<circle cx="${x + dx}" cy="${y + dy}" r="${r}" fill="${fill}"/>`);
      }
    }
  }

  // Soft layers fade to transparent instead of carrying a blur filter: a filter
  // would have to be re-rasterized, a gradient is baked into the tile once.
  const defs = [...gradients]
    .map((ci) => `<radialGradient id="g${ci}"><stop offset="0" stop-color="${colors[ci]}"/><stop offset="1" stop-color="${colors[ci].replace(/[\d.]+\)$/, '0)')}"/></radialGradient>`)
    .join('');

  const svg =
    `<svg xmlns="http://www.w3.org/2000/svg" width="${tile}" height="${tile}" viewBox="0 0 ${tile} ${tile}">` +
    (defs ? `<defs>${defs}</defs>` : '') +
    body.join('') +
    '</svg>';
  return `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
}

const r = rng(20260625);
const tiles = Object.fromEntries(LAYERS.map((layer) => [layer.key, tileUri(r, layer)]));
const vars = LAYERS.map((l) => `--img-${l.key}:${tiles[l.key]}; --t-${l.key}:${l.tile}px`).join('; ');
---

<div class="circles" aria-hidden="true" style={vars}>
  {LAYERS.map((layer) => <div class:list={['cir', layer.key]} />)}
</div>

<style>
  .circles {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    /* a touch of depth: warm glow up top, pooled shadow at the floor */
    background:
      radial-gradient(ellipse 120% 80% at 50% 120%, rgba(61, 19, 32, 0.55) 0%, rgba(0, 0, 0, 0) 60%),
      radial-gradient(ellipse at 50% -10%, rgba(140, 36, 52, 0.18) 0%, rgba(0, 0, 0, 0) 45%),
      var(--bg);
  }

  /* One extra tile fills the space exposed by a complete drift cycle. The
     gradient backdrop remains still; only the cream/gold layers move. */
  .cir {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: calc(100% + var(--tile));
    background-repeat: repeat;
    background-size: var(--tile) var(--tile);
  }
  .cir.lg {
    background-image: var(--img-lg);
    --tile: var(--t-lg);
    --speed: 192s;
    --tw-duration: 19s;
    --tw-delay: -4s;
    --lo: 0.65;
  }
  .cir.orb {
    background-image: var(--img-orb);
    --tile: var(--t-orb);
    --speed: 144s;
    --tw-duration: 15s;
    --lo: 0.6;
  }
  .cir.bg {
    background-image: var(--img-bg);
    --tile: var(--t-bg);
    --speed: 80s;
    --tw-duration: 11s;
    --tw-delay: -5s;
    --lo: 0.5;
  }
  .cir.md {
    background-image: var(--img-md);
    --tile: var(--t-md);
    --speed: 56s;
    --tw-duration: 9s;
    --tw-delay: -3s;
    --lo: 0.4;
  }
  .cir.sm {
    background-image: var(--img-sm);
    --tile: var(--t-sm);
    --speed: 36s;
    --tw-duration: 7s;
    --lo: 0.35;
  }
  .cir.spA {
    background-image: var(--img-spA);
    --tile: var(--t-spA);
    --speed: 28s;
    --tw-duration: 3.2s;
    --lo: 0.1;
  }
  .cir.spB {
    background-image: var(--img-spB);
    --tile: var(--t-spB);
    --speed: 33s;
    --tw-duration: 4.6s;
    --tw-delay: -1.6s;
    --lo: 0.12;
  }
  /* A sparse downward current gives the rising lights depth. */
  .cir.dn {
    top: calc(-1 * var(--tile));
    background-image: var(--img-dn);
    --tile: var(--t-dn);
    --drift: var(--tile);
    --speed: 52s;
    --tw-duration: 8s;
    --tw-delay: -2s;
    --lo: 0.3;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cir {
      animation:
        circle-drift var(--speed) linear infinite,
        circle-twinkle var(--tw-duration) ease-in-out var(--tw-delay, 0s) infinite;
      animation-play-state: paused;
    }

    :global(html.bg-live) .cir {
      animation-play-state: running;
    }
  }

  @keyframes circle-drift {
    from { transform: translateY(0); }
    to { transform: translateY(var(--drift, calc(-1 * var(--tile)))); }
  }

  @keyframes circle-twinkle {
    0%, 100% { opacity: var(--lo); }
    50% { opacity: 1; }
  }
</style>
