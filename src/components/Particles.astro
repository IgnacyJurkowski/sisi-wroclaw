---
/*
 * Particles — the site's living backdrop: a field of soft cream/gold circles
 * drifting up through the wine, like light motes or champagne bubbles in a dark
 * club. Pure CSS, no JS, no library. It sits fixed behind everything
 * (z-index:-1) and shows through every transparent section below the hero, so
 * the page never reads as flat wine.
 *
 * Each layer is a seamless SVG tile, generated here at build time by a seeded
 * RNG (so the field is identical on every page and reproducible build-to-build)
 * and repeated across the viewport. The layer element is exactly the viewport
 * plus one tile tall, so drifting it by one tile height loops forever with no
 * seam — and the browser only ever rasterizes about a viewport's worth of
 * pixels per layer.
 *
 * This replaced a box-shadow starfield, where each layer painted the entire
 * 2560x2000 field (plus a duplicate offset by the tile height) whether or not
 * it was on screen: eight layers came to ~82 Mpx of continuously composited
 * texture to fill a ~1.4 Mpx viewport, which measured ~10x the frame cost of
 * the rest of the page and made the site lag on integrated graphics. Same look,
 * roughly a viewport of paint per layer instead of 58 viewports.
 *
 * Motion is two compositor-only properties: a transform (the drift) and opacity
 * (a staggered twinkle). The field starts frozen and only begins to move once
 * the page has finished loading (Base.astro adds html.bg-live after load +
 * idle), so it never inflates mobile Speed Index. Reduced motion keeps it
 * frozen.
 */
type Rand = () => number;
function rng(seed: number): Rand {
  return function () {
    seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

/** The old field's area — every layer's density is still quoted against it, so
    the tiles carry the same number of circles per pixel as the original. */
const SOURCE_AREA = 2560 * 2000;

type Layer = {
  key: string;
  /** circles the original field scattered over SOURCE_AREA */
  count: number;
  /** circle radius in px */
  r: number;
  colors: string[];
  /** soft-edged (the glowing orbs and bokeh) rather than a crisp dot */
  soft?: boolean;
  /** tile edge in px; larger tiles repeat less visibly for sparse layers */
  tile: number;
};

const LAYERS: Layer[] = [
  { key: 'lg',  count: 14,  r: 10,  tile: 1200, soft: true, colors: ['rgba(245,232,213,0.13)', 'rgba(251,210,149,0.11)'] },
  { key: 'orb', count: 26,  r: 6,   tile: 1200, soft: true, colors: ['rgba(251,210,149,0.20)', 'rgba(237,219,194,0.18)'] },
  { key: 'bg',  count: 40,  r: 2,   tile: 800,  colors: ['rgba(237,219,194,0.85)', 'rgba(245,232,213,0.7)'] },
  { key: 'md',  count: 90,  r: 1.5, tile: 800,  colors: ['rgba(251,210,149,0.7)', 'rgba(245,232,213,0.6)'] },
  { key: 'sm',  count: 200, r: 1,   tile: 800,  colors: ['rgba(237,219,194,0.85)', 'rgba(245,232,213,0.7)'] },
  { key: 'spA', count: 26,  r: 1,   tile: 800,  colors: ['rgba(255,250,242,0.95)', 'rgba(255,243,214,0.92)'] },
  { key: 'spB', count: 22,  r: 1,   tile: 800,  colors: ['rgba(255,238,205,0.95)', 'rgba(255,250,242,0.9)'] },
  { key: 'dn',  count: 34,  r: 1,   tile: 800,  colors: ['rgba(237,219,194,0.85)', 'rgba(245,232,213,0.7)'] },
];

/** One seamless tile as an SVG data URI. Circles within a radius of an edge are
    drawn again on the opposite side, so the repeat has no visible seam. */
function tileUri(rand: Rand, layer: Layer): string {
  const { tile, r, colors, soft } = layer;
  const n = Math.max(2, Math.round((layer.count * tile * tile) / SOURCE_AREA));
  const body: string[] = [];
  const gradients = new Set<number>();

  for (let i = 0; i < n; i++) {
    const x = Math.round(rand() * tile);
    const y = Math.round(rand() * tile);
    const ci = Math.floor(rand() * colors.length);
    if (soft) gradients.add(ci);
    for (const dx of x < r ? [0, tile] : x > tile - r ? [0, -tile] : [0]) {
      for (const dy of y < r ? [0, tile] : y > tile - r ? [0, -tile] : [0]) {
        const fill = soft ? `url(#g${ci})` : colors[ci];
        body.push(`<circle cx="${x + dx}" cy="${y + dy}" r="${r}" fill="${fill}"/>`);
      }
    }
  }

  // Soft layers fade to transparent instead of carrying a blur filter: a filter
  // would have to be re-rasterized, a gradient is baked into the tile once.
  const defs = [...gradients]
    .map((ci) => `<radialGradient id="g${ci}"><stop offset="0" stop-color="${colors[ci]}"/><stop offset="1" stop-color="${colors[ci].replace(/[\d.]+\)$/, '0)')}"/></radialGradient>`)
    .join('');

  const svg =
    `<svg xmlns="http://www.w3.org/2000/svg" width="${tile}" height="${tile}" viewBox="0 0 ${tile} ${tile}">` +
    (defs ? `<defs>${defs}</defs>` : '') +
    body.join('') +
    '</svg>';
  return `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
}

const r = rng(20260625);
const tiles = Object.fromEntries(LAYERS.map((layer) => [layer.key, tileUri(r, layer)]));
const vars = LAYERS.map((l) => `--img-${l.key}:${tiles[l.key]}; --t-${l.key}:${l.tile}px`).join('; ');
---

<div class="circles" aria-hidden="true" style={vars}>
  {LAYERS.map((layer) => <div class:list={['cir', layer.key]} />)}
</div>

<style>
  .circles {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    /* a touch of depth: warm glow up top, pooled shadow at the floor */
    background:
      radial-gradient(ellipse 120% 80% at 50% 120%, rgba(61, 19, 32, 0.55) 0%, rgba(0, 0, 0, 0) 60%),
      radial-gradient(ellipse at 50% -10%, rgba(140, 36, 52, 0.18) 0%, rgba(0, 0, 0, 0) 45%),
      var(--bg);
  }

  /* Each layer is the viewport plus one tile tall and repeats its own tile, so
     a one-tile drift loops seamlessly while the rasterized area stays close to
     the viewport. --lo is the layer's dim point, so big orbs pulse gently and
     sparks flicker hard. No will-change: the animations promote these to
     compositor layers on their own, and pinning eight oversized textures for
     the life of the page was part of what made this expensive. */
  .cir {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    background-repeat: repeat;
  }
  .cir.lg  { height: calc(100% + var(--t-lg));  background-image: var(--img-lg);  background-size: var(--t-lg) var(--t-lg);   --lo: 0.65; }
  .cir.orb { height: calc(100% + var(--t-orb)); background-image: var(--img-orb); background-size: var(--t-orb) var(--t-orb); --lo: 0.6; }
  .cir.bg  { height: calc(100% + var(--t-bg));  background-image: var(--img-bg);  background-size: var(--t-bg) var(--t-bg);   --lo: 0.5; }
  .cir.md  { height: calc(100% + var(--t-md));  background-image: var(--img-md);  background-size: var(--t-md) var(--t-md);   --lo: 0.4; }
  .cir.sm  { height: calc(100% + var(--t-sm));  background-image: var(--img-sm);  background-size: var(--t-sm) var(--t-sm);   --lo: 0.35; }
  .cir.spA { height: calc(100% + var(--t-spA)); background-image: var(--img-spA); background-size: var(--t-spA) var(--t-spA); --lo: 0.1; }
  .cir.spB { height: calc(100% + var(--t-spB)); background-image: var(--img-spB); background-size: var(--t-spB) var(--t-spB); --lo: 0.12; }
  /* The cross-current drifts the other way, so its slack tile sits above. */
  .cir.dn  {
    top: calc(-1 * var(--t-dn));
    height: calc(100% + var(--t-dn));
    background-image: var(--img-dn);
    background-size: var(--t-dn) var(--t-dn);
    --lo: 0.3;
  }

  /* Motion switches on only once html.bg-live is set (post-load, see
     Base.astro). Durations are the original field's speeds re-expressed for the
     shorter loop, so the drift reads at exactly the same pace as before. */
  html.bg-live .cir.sm  { animation: up   36s linear infinite, tw 7s   ease-in-out infinite; }
  html.bg-live .cir.md  { animation: up   56s linear infinite, tw 9s   ease-in-out infinite -3s; }
  html.bg-live .cir.bg  { animation: up   80s linear infinite, tw 11s  ease-in-out infinite -5s; }
  html.bg-live .cir.orb { animation: upLg 144s linear infinite, tw 15s ease-in-out infinite; }
  html.bg-live .cir.lg  { animation: upLg 192s linear infinite, tw 19s ease-in-out infinite -4s; }
  html.bg-live .cir.spA { animation: up   28s linear infinite, tw 3.2s ease-in-out infinite; }
  html.bg-live .cir.spB { animation: up   33s linear infinite, tw 4.6s ease-in-out infinite -1.6s; }
  html.bg-live .cir.dn  { animation: down 52s linear infinite, tw 8s   ease-in-out infinite -2s; }

  @media (prefers-reduced-motion: reduce) {
    html.bg-live .cir { animation: none; }
  }

  @keyframes up {
    from { transform: translateY(0); }
    to   { transform: translateY(-800px); }
  }
  @keyframes upLg {
    from { transform: translateY(0); }
    to   { transform: translateY(-1200px); }
  }
  @keyframes down {
    from { transform: translateY(0); }
    to   { transform: translateY(800px); }
  }
</style>
