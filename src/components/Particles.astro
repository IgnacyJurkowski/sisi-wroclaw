---
/*
 * Particles — the site's living backdrop: a field of soft cream/gold circles
 * drifting up through the wine, like motes of light in a dark club. It sits
 * fixed behind everything (z-index:-1) and shows through every transparent
 * section below the hero, so the page never reads as flat wine.
 *
 * Two renderings of one field (src/scripts/backdrop/field.ts owns the model):
 *
 *   1. Static tiles, here, at build time. Each layer is a seamless SVG tile
 *      from a seeded RNG, repeated across the viewport. This is first paint,
 *      and the whole backdrop for clients without JS or with reduced motion.
 *   2. One <canvas>, added by src/scripts/backdrop/index.ts and drawn from a
 *      Web Worker. Its first frame is the same tiles dot for dot, so the CSS
 *      cross-fade below is invisible; after load + idle the field drifts.
 *
 * Why not animate the tiles with CSS, as this component once did: eight
 * full-window layers each animating meant eight window-sized plates composited
 * every frame, plus a re-blur of every glass panel (backdrop-filter) above
 * them. The cost scaled with window area - fine on a phone, a slideshow on a
 * 1440p or 4K desktop with integrated graphics. The canvas is one plate, its
 * frame is a few hundred sprite draws, and none of it runs on the main thread.
 * See scripts/backdrop-fps.mjs for the measurement.
 */
import { generateTiles, tileDataUri } from '../scripts/backdrop/field';

const tiles = generateTiles();
const vars = tiles
  .map((tile) => `--img-${tile.layer.key}:${tileDataUri(tile)}; --t-${tile.layer.key}:${tile.layer.tile}px`)
  .join('; ');
---

<div class="circles" aria-hidden="true" data-backdrop="tiles" style={vars}>
  <div class="tiles">
    {tiles.map(({ layer }) => <div class:list={['cir', layer.key]} />)}
  </div>
</div>
<script>import '../scripts/backdrop/index.ts';</script>

<style>
  .circles {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    /* a touch of depth: warm glow up top, pooled shadow at the floor */
    background:
      radial-gradient(ellipse 120% 80% at 50% 120%, rgba(61, 19, 32, 0.55) 0%, rgba(0, 0, 0, 0) 60%),
      radial-gradient(ellipse at 50% -10%, rgba(140, 36, 52, 0.18) 0%, rgba(0, 0, 0, 0) 45%),
      var(--bg);
  }

  /* The static field: eight tiles painted once into the page's own layer.
     Nothing here animates. Once the canvas has drawn its (identical) first
     frame the host leaves data-backdrop="tiles" and this fades out, then
     stops being painted at all. */
  .tiles,
  .cir {
    position: absolute;
    inset: 0;
  }
  .tiles {
    transition: opacity 0.6s ease, visibility 0s linear 0.6s;
  }
  .circles:not([data-backdrop='tiles']) .tiles {
    opacity: 0;
    visibility: hidden;
  }
  .cir { background-repeat: repeat; }
  .cir.lg  { background-image: var(--img-lg);  background-size: var(--t-lg) var(--t-lg); }
  .cir.orb { background-image: var(--img-orb); background-size: var(--t-orb) var(--t-orb); }
  .cir.bg  { background-image: var(--img-bg);  background-size: var(--t-bg) var(--t-bg); }
  .cir.md  { background-image: var(--img-md);  background-size: var(--t-md) var(--t-md); }
  .cir.sm  { background-image: var(--img-sm);  background-size: var(--t-sm) var(--t-sm); }
  .cir.spA { background-image: var(--img-spA); background-size: var(--t-spA) var(--t-spA); }
  .cir.spB { background-image: var(--img-spB); background-size: var(--t-spB) var(--t-spB); }
  .cir.dn  { background-image: var(--img-dn);  background-size: var(--t-dn) var(--t-dn); }

  /* The moving field: one layer, the size of the window, created by the
     script (hence :global). It is the only thing about the backdrop the
     compositor touches per frame. */
  .circles > :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .circles:not([data-backdrop='tiles']) > :global(canvas) {
    opacity: 1;
  }
</style>
