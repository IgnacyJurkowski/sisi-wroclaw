---
// The Cork kitchen menu: cream background with burgundy type and icons.
// Menu content and homepage selections share the same translated dish data.
import { type Locale } from '../i18n/config';
import { ICONS, DIET, SPICY, TAGLINE, SECTIONS } from '../data/food-menu';
interface Props { locale: Locale }
const { locale } = Astro.props;
---

<section id="food" class="food-menu" data-reveal-group>
  <div class="food-inner">
    <header class="food-head" data-reveal>
      <span class="food-eyebrow">{TAGLINE.eyebrow}</span>
      <h2 class="food-title display">{TAGLINE.heading[locale]}</h2>
      <p class="food-sub">{TAGLINE.sub[locale]}</p>
    </header>

    <div class="food-grid">
      {SECTIONS.map((sec) => (
        <div class="food-col" data-reveal>
          <h3 class="food-section-label"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={sec.icon} />{sec.title[locale]}</h3>
          {sec.dishes.map((d) => (
            <article class="food-item">
              <svg class="food-item-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={d.icon} />
              <div class="food-item-body">
                <div class="food-item-text">
                  <h4 class="food-name">
                    {d.name[locale]}
                    {(d.diet || d.spicy) && (
                      <span class="food-badges">
                        {d.diet && (
                          <span class="food-badge food-badge-veg" role="img" title={DIET[d.diet][locale]} aria-label={DIET[d.diet][locale]}>
                            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS.leafCircle} />
                          </span>
                        )}
                        {d.spicy && (
                          <span class="food-badge food-badge-spicy" role="img" title={SPICY[locale]} aria-label={SPICY[locale]}>
                            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS.chili} />
                          </span>
                        )}
                      </span>
                    )}
                  </h4>
                  {d.desc && <p class="food-desc">{d.desc[locale]}</p>}
                </div>
                {d.tiers.length > 0 && (
                  <div class="food-prices">
                    {d.tiers.map((tr) => (
                      <span class="food-price">
                        {tr.qty && <span class="food-qty">{tr.qty[locale]}</span>}{tr.price}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .food-menu { scroll-margin-top: 100px; }
  /* Full-bleed cream band, colour-inverted from the dark bar cards. Sits above
     the fixed particle backdrop (opaque cream covers it in this band). */
  .food-menu {
    position: relative; z-index: 1;
    background: var(--cream);
    color: #27060f;
    margin-top: 96px;
    padding: 96px 32px 104px;
  }
  .food-inner { max-width: var(--maxw); margin: 0 auto; }

  .food-head { text-align: center; max-width: 640px; margin: 0 auto 64px; }
  .food-eyebrow {
    display: inline-block; font-size: 12px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.18em;
    color: rgba(39, 7, 15, 0.72); margin-bottom: 18px;
  }
  .food-title {
    font-size: clamp(2rem, 4.5vw, 3.2rem); line-height: 1.05;
    text-transform: uppercase; letter-spacing: -0.01em;
    color: #27060f; margin: 0 0 18px;
  }
  .food-sub { font-size: 15px; line-height: 1.7; color: rgba(39, 7, 15, 0.62); margin: 0; }

  .food-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 24px 56px;
    max-width: 980px; margin: 0 auto; align-items: start;
  }
  .food-section-label {
    display: flex; align-items: center; gap: 11px;
    font-family: var(--font-display); font-size: 1.35rem; font-weight: 400;
    text-transform: uppercase; letter-spacing: 0.05em; color: #27060f;
    margin: 0 0 6px; padding-bottom: 14px;
    border-bottom: 1px solid rgba(39, 7, 15, 0.18);
  }
  .food-section-label svg {
    width: 22px; height: 22px; flex-shrink: 0;
    fill: none; stroke: #27060f; stroke-width: 1.7;
    stroke-linecap: round; stroke-linejoin: round;
  }
  .food-item { display: flex; gap: 12px; padding: 18px 0; border-bottom: 1px solid rgba(39, 7, 15, 0.1); }
  .food-item:last-child { border-bottom: none; }
  .food-item-icon {
    width: 27px; height: 27px; flex-shrink: 0; margin-top: 0;
    color: #27060f; fill: none; stroke: currentColor; stroke-width: 1.4;
    stroke-linecap: round; stroke-linejoin: round;
  }
  .food-item-body { flex: 1; min-width: 0; display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .food-item-text { flex: 1; min-width: 0; }
  .food-name { font-size: 16px; font-weight: 700; letter-spacing: 0.01em; color: #27060f; margin: 0; }
  .food-badges { display: inline-flex; gap: 5px; margin-left: 8px; vertical-align: middle; }
  .food-badge {
    display: inline-flex; align-items: center; justify-content: center;
    width: 21px; height: 21px; border-radius: 50%; border: 1px solid;
  }
  .food-badge svg {
    width: 12px; height: 12px; fill: none; stroke-width: 1.9;
    stroke-linecap: round; stroke-linejoin: round;
  }
  .food-badge-veg, .food-badge-spicy { color: #27060f; border-color: rgba(39, 6, 15, 0.3); background: transparent; }
  .food-badge-veg svg, .food-badge-spicy svg { stroke: currentColor; }
  .food-prices { flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; gap: 2px; text-align: right; }
  .food-price { font-size: 14px; font-weight: 600; color: #27060f; white-space: nowrap; }
  .food-qty { font-size: 11px; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; color: rgba(39, 7, 15, 0.72); margin-right: 8px; }
  .food-desc { font-size: 13px; line-height: 1.6; color: rgba(39, 7, 15, 0.62); margin: 4px 0 0; max-width: 46ch; white-space: pre-line; }

  @media (max-width: 760px) {
    .food-menu { margin-top: 72px; padding: 72px 20px 80px; }
    .food-grid { grid-template-columns: 1fr; gap: 8px; }
    .food-head { margin-bottom: 48px; }
  }
</style>
