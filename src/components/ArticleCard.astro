---
import type { ArticleItem } from '../data/articles';
import { type Locale } from '../i18n/config';
import { articlePath } from '../i18n/routes';
import { formatLongDate } from '../i18n/format';
import { useTranslations, interpolate } from '../i18n/t';

interface Props { article: ArticleItem; locale: Locale }
const { article, locale } = Astro.props;
const t = useTranslations(locale);
const href = articlePath(article.slug, locale);
const imgSizes = '(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 30vw';
const reading = interpolate(t.blogPage.readingTime, { minutes: String(article.readingMinutes) });
---

<article class="bl-card">
  {article.img && (
    <a class="bl-media" href={href} tabindex="-1" aria-hidden="true">
      <img
        src={article.img}
        srcset={article.imgSrcset}
        sizes={imgSizes}
        width={article.imgWidth}
        height={article.imgHeight}
        alt=""
        loading="lazy"
        decoding="async"
      />
    </a>
  )}
  <div class="bl-body">
    <p class="bl-meta">
      <time datetime={article.publishedAt}>{formatLongDate(article.publishedAt, locale)}</time>
      <span aria-hidden="true">·</span>
      <span>{reading}</span>
    </p>
    <h2 class="display bl-title"><a href={href}>{article.title}</a></h2>
    <p class="bl-excerpt">{article.excerpt}</p>
    <span class="bl-more" aria-hidden="true">{t.blogPage.readMore} →</span>
  </div>
</article>

<style>
  .bl-card {
    /* glass — same recipe as the event cards and nav. */
    background: rgba(39, 7, 15, 0.42);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(237, 219, 194, 0.18);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .bl-media { display: block; position: relative; overflow: hidden; }
  .bl-media::before { content: ''; display: block; padding-top: 56.25%; }
  .bl-media img {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 400ms ease;
  }
  .bl-card:hover .bl-media img { transform: scale(1.04); }
  .bl-body { padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .bl-meta {
    display: flex; align-items: center; flex-wrap: wrap; gap: 8px;
    font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--text-mute); margin: 0;
  }
  .bl-title { font-size: clamp(1.15rem, 2.2vw, 1.45rem); line-height: 1.25; margin: 0; }
  .bl-title a { color: inherit; text-decoration: none; }
  .bl-title a:hover { color: var(--gold); }
  .bl-excerpt { margin: 0; font-size: 15px; line-height: 1.65; color: var(--text-dim); }
  .bl-more {
    margin-top: auto; padding-top: 6px;
    font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cream);
  }
</style>
