---
/* Hand-drawn vector plan of the R32 floor: the SiSi club (top-left L-shape)
   and The Cork restaurant (right column + lower block), traced from the
   venue's functional layout and simplified to clean shapes in the brand
   burgundy / cream. Each venue is one <g data-map-space> that the
   configurator script wires up as a button; the furniture is decorative and
   never intercepts pointer events. Coordinates are in a 468x649 box. */
interface Props {
  labels: { sisi: string; cork: string };
  hint: string;
}
const { labels, hint } = Astro.props;

// Round four-seat table: top + chairs on the diagonals.
const round4 = (cx: number, cy: number) => ({ cx, cy, chairs: [[-15, -15], [15, -15], [-15, 15], [15, 15]] });
// Two-seat table with chairs left/right (horizontal) or above/below (vertical).
const pair = (cx: number, cy: number, vertical = false) => ({ cx, cy, vertical });

const SISI_ROUND = [[192, 34], [236, 62], [274, 40], [254, 92]];
const CORK_LEFT_PAIRS = [145, 170, 215, 240, 268, 293].map((y) => pair(300, y));
const CORK_MID_ROUND = [165, 220, 275, 330].map((y) => round4(362, y));
const CORK_RIGHT_SQUARE = [165, 220, 275, 330];
const CORK_LOWER_PAIRS = [[205, 500], [205, 530], [205, 560]].map(([x, y]) => pair(x, y));
const CORK_RIGHT_PAIRS = [[440, 490], [440, 520], [440, 550]].map(([x, y]) => pair(x, y));
const CORK_BOTTOM_ROUND = [[165, 612], [215, 612], [365, 612], [415, 612]].map(([x, y]) => round4(x, y));
const CORK_UPPER_ROUND = [[375, 472], [375, 516]].map(([x, y]) => round4(x, y));
const COMMUNITY_CHAIRS = [350, 372, 394, 416];
---

<svg class="cfg-map-svg" viewBox="0 0 468 649" role="group" aria-label={hint} focusable="false">
  <!-- SiSi club -->
  <g class="cfg-map-region" role="button" tabindex="0" aria-pressed="false" aria-label={labels.sisi} data-map-space="sisi">
    <path class="room" d="M4 4H306V103H268V296H4Z" />
    <g class="furniture">
      <!-- top booth row -->
      <rect class="soft" x="14" y="12" width="140" height="16" rx="6" />
      {[45, 85, 125].map((x) => <circle class="table" cx={x} cy="40" r="9" />)}
      <!-- side booths -->
      <rect class="soft" x="12" y="58" width="22" height="158" rx="8" />
      {[86, 126, 166, 204].map((y) => <circle class="table" cx="52" cy={y} r="9" />)}
      <!-- high tables with stools -->
      {SISI_ROUND.map(([x, y]) => (
        <>
          <circle class="table" cx={x} cy={y} r="8" />
          {[[0, -13], [11, 7], [-11, 7]].map(([dx, dy]) => <circle class="chair" cx={x + dx} cy={y + dy} r="3.2" />)}
        </>
      ))}
      <!-- stage / dance floor -->
      <rect class="stage" x="140" y="110" width="118" height="82" rx="10" />
      <!-- bar counter -->
      <rect class="bar" x="78" y="212" width="184" height="72" rx="14" />
      <rect class="counter" x="98" y="228" width="140" height="40" rx="8" />
    </g>
    <text class="label" x="199" y="160" text-anchor="middle">SiSi</text>
  </g>

  <!-- The Cork restaurant -->
  <g class="cfg-map-region" role="button" tabindex="0" aria-pressed="false" aria-label={labels.cork} data-map-space="cork">
    <path class="room" d="M310 107H464V645H139V430H229V300H272V107Z" />
    <g class="furniture">
      <!-- pass / bar along the top -->
      <rect class="soft" x="322" y="114" width="138" height="18" rx="5" />
      <!-- left column: two-seat tables -->
      {CORK_LEFT_PAIRS.map((t) => (
        <>
          <rect class="table" x={t.cx - 8} y={t.cy - 5} width="16" height="10" rx="2" />
          <circle class="chair" cx={t.cx - 15} cy={t.cy} r="4" />
          <circle class="chair" cx={t.cx + 15} cy={t.cy} r="4" />
        </>
      ))}
      <!-- middle column: round four-seat tables -->
      {[...CORK_MID_ROUND, ...CORK_BOTTOM_ROUND, ...CORK_UPPER_ROUND].map((t) => (
        <>
          <circle class="table" cx={t.cx} cy={t.cy} r="11" />
          {t.chairs.map(([dx, dy]) => <circle class="chair" cx={t.cx + dx} cy={t.cy + dy} r="4.5" />)}
        </>
      ))}
      <!-- right column: square tables with wall benches -->
      {CORK_RIGHT_SQUARE.map((y) => (
        <>
          <rect class="soft" x="436" y={y - 14} width="20" height="28" rx="4" />
          <rect class="table" x="402" y={y - 9} width="22" height="18" rx="3" />
          <circle class="chair" cx="388" cy={y - 6} r="4.5" />
          <circle class="chair" cx="388" cy={y + 6} r="4.5" />
        </>
      ))}
      <!-- lower block: two-seat tables left and right -->
      {[...CORK_LOWER_PAIRS, ...CORK_RIGHT_PAIRS].map((t) => (
        <>
          <rect class="table" x={t.cx - 8} y={t.cy - 5} width="16" height="10" rx="2" />
          <circle class="chair" cx={t.cx - 15} cy={t.cy} r="4" />
          <circle class="chair" cx={t.cx + 15} cy={t.cy} r="4" />
        </>
      ))}
      <!-- community table -->
      <rect class="table" x="335" y="544" width="90" height="44" rx="5" />
      {COMMUNITY_CHAIRS.map((x) => (
        <>
          <circle class="chair" cx={x} cy="534" r="4.5" />
          <circle class="chair" cx={x} cy="598" r="4.5" />
        </>
      ))}
    </g>
    <text class="label" x="292" y="466" text-anchor="middle">The Cork</text>
  </g>
</svg>

<style>
  .cfg-map-svg { display: block; width: 100%; height: auto; overflow: visible; }
  .cfg-map-region { cursor: pointer; outline: none; }
  .room {
    fill: #4a1424; stroke: rgba(237,219,194,0.55); stroke-width: 3; stroke-linejoin: round;
    transition: fill 150ms ease, stroke 150ms ease;
  }
  .furniture { pointer-events: none; }
  .table { fill: rgba(237,219,194,0.9); }
  .chair { fill: rgba(237,219,194,0.6); }
  .soft { fill: rgba(237,219,194,0.42); }
  .stage { fill: #5e1a2d; stroke: rgba(237,219,194,0.35); stroke-width: 1.5; }
  .bar { fill: #5e1a2d; stroke: rgba(237,219,194,0.85); stroke-width: 3; }
  .counter { fill: #330c19; }
  .label {
    fill: var(--cream); font-family: var(--font-display); font-size: 24px; letter-spacing: 0.04em; text-transform: uppercase;
    paint-order: stroke; stroke: rgba(39,6,15,0.75); stroke-width: 6px; stroke-linejoin: round; pointer-events: none;
  }
  .cfg-map-region:hover .room { fill: #5c1a2e; stroke: rgba(237,219,194,0.85); }
  .cfg-map-region:focus-visible .room { stroke: var(--gold); stroke-width: 4; }
  .cfg-map-region.is-selected .room { fill: #63203a; stroke: var(--gold); stroke-width: 3.5; }
  .cfg-map-region.is-selected .label { fill: var(--gold); }
</style>
