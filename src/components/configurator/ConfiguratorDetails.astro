---
import { SEATINGS } from '../../data/configurator';
import { CORK_EXTENSIONS } from '../../data/cork-configurator.mjs';
import { type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/t';
import DatePicker from '../DatePicker.astro';
import NumberStepper from '../NumberStepper.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const c = t.configurator;
const d = c.details;
const shared = t.b2b.form;
const pl = useTranslations('pl').configurator.details;
const seatingHints = { seated: d.seating.seatedHint, standing: d.seating.standingHint, mixed: d.seating.mixedHint } as const;
const extLabel = (key: string) => (key === 'plus1' ? d.duration.plus1 : key === 'plus2' ? d.duration.plus2 : d.duration.none);
const extLabelPl = (key: string) => (key === 'plus1' ? pl.duration.plus1 : key === 'plus2' ? pl.duration.plus2 : pl.duration.none);
---

<section id="cfg-details" class="cfg-step" data-cfg-step="details">
  <div class="container">
    <div class="cfg-step-head" data-reveal>
      <p class="cfg-step-kicker">{c.progress.stepLabel.replace('{n}', '2')} · {c.progress.steps.details}</p>
      <h2 class="display cfg-step-title">{d.heading}</h2>
    </div>

    <div class="sisi-card cfg-card cfg-details" data-reveal>
      <div class="cfg-details-grid">
        <div class="cfg-field cfg-field-date">
          <label class="cfg-label" for="cfg-date">{shared.date} <span class="req" aria-hidden="true">*</span></label>
          <DatePicker
            id="cfg-date"
            name="preferred_date"
            locale={locale}
            required
            describedby="cfg-err-preferred_date"
            placeholder={shared.datePlaceholder}
            modeSingle={shared.dateModeSingle}
            modeRange={shared.dateModeRange}
            prevMonth={shared.datePrevMonth}
            nextMonth={shared.dateNextMonth}
            clear={shared.dateClear}
          />
          <p class="cfg-field-error" id="cfg-err-preferred_date" data-error-for="preferred_date" hidden></p>
        </div>

        <div class="cfg-field">
          <label class="cfg-label" for="cfg-time">{d.time} <span class="opt">{shared.optional}</span></label>
          <select id="cfg-time" name="start_time" class="cfg-select" data-cfg-time>
            <option value="">—</option>
          </select>
          <p class="cfg-hint" data-cork-only>{d.timeHint}</p>
        </div>

        <div class="cfg-field">
          <label class="cfg-label" for="cfg-guests">{d.adults} <span class="req" aria-hidden="true">*</span></label>
          <NumberStepper id="cfg-guests" name="guests" min={1} required describedby="cfg-err-guests" decreaseLabel={shared.guestsDecrease} increaseLabel={shared.guestsIncrease} />
          <p class="cfg-field-error" id="cfg-err-guests" data-error-for="guests" hidden></p>
        </div>

      </div>

      <fieldset class="cfg-fieldset">
        <legend class="cfg-label">{d.seating.label}</legend>
        <div class="cfg-grid-3">
          {SEATINGS.map((key) => (
            <label class="cfg-choice">
              <input type="radio" name="seating" value={pl.seating[key]} data-key={key} data-label={d.seating[key]} checked={key === 'standing'} />
              <span class="cfg-choice-body">
                <span class="cfg-choice-title">{d.seating[key]}</span>
                <span class="cfg-choice-sub">{seatingHints[key]}</span>
              </span>
              <span class="cfg-choice-check" aria-hidden="true">✓</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="cfg-fieldset" data-cork-only>
        <legend class="cfg-label">{d.duration.label}</legend>
        <p class="cfg-duration"><span data-duration-base>{d.duration.base.replace('{guests}', '10')}</span> <strong data-duration-hours>{d.duration.hours.replace('{hours}', '3')}</strong></p>
        <div class="cfg-grid-3">
          {CORK_EXTENSIONS.map((ext) => (
            <label class="cfg-choice">
              <input type="radio" name="extension" value={extLabelPl(ext.key)} data-key={ext.key} data-pct={Math.round(ext.surcharge * 100)} data-label={extLabel(ext.key)} checked={ext.key === 'none'} />
              <span class="cfg-choice-body">
                <span class="cfg-choice-title">{extLabel(ext.key)}</span>
                <span class="cfg-choice-sub">{ext.surcharge ? d.duration.surcharge.replace('{pct}', String(Math.round(ext.surcharge * 100))) : d.duration.noneHint}</span>
              </span>
              <span class="cfg-choice-check" aria-hidden="true">✓</span>
            </label>
          ))}
        </div>
      </fieldset>

      <p class="cfg-notice" data-capacity-notice role="status" hidden></p>
      <p class="cfg-notice" data-cork-notice role="status" hidden></p>

      <div class="cfg-actions" data-step-actions>
        <a href="#cfg-menu" class="btn-cta cfg-next">{c.buttons.toMenu}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4"/></svg></a>
      </div>
    </div>
  </div>
</section>

<style>
  .cfg-details-grid { display: grid; grid-template-columns: 1.4fr 1fr 0.9fr; gap: 14px 16px; }
  .cfg-details-grid > * { min-width: 0; }
  .cfg-fieldset { border: none; margin: 18px 0 0; padding: 0; min-width: 0; }
  .cfg-fieldset legend { padding: 0; }
  .cfg-duration { font-size: 13px; color: var(--text-faint); margin: -2px 0 10px; }
  .cfg-duration strong { color: var(--cream); }
  @media (max-width: 960px) {
    .cfg-details-grid { grid-template-columns: 1fr 1fr; }
    .cfg-field-date { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) { .cfg-details-grid { grid-template-columns: 1fr; } }
</style>
