---
import { SPACES } from '../../data/configurator';
import { type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/t';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = useTranslations(locale).configurator;
const plSpaces = useTranslations('pl').configurator.space.options;
// The plan is The Cork / SiSi functional layout redrawn for this site as a
// burgundy / cream duotone: zone markers, titles and the toilet block removed,
// background transparent - the same R32 footprint the B2B page describes.
// MAP_REGIONS traces the two venues in the image's own 468x649 pixel space and
// powers the clickable overlay (each region selects the matching radio).
const PLAN = '/images/plan-r32';
const PLAN_W = 468;
const PLAN_H = 649;
const MAP_REGIONS = [
  { key: 'sisi', label: 'SiSi', points: '0,0 310,0 310,105 285,105 285,300 0,300', labelAt: [118, 205] },
  { key: 'cork', label: 'The Cork', points: '310,105 468,105 468,649 135,649 135,430 225,430 225,300 285,300 285,105', labelAt: [318, 500] },
] as const;
---

<section id="cfg-space" class="cfg-step" data-cfg-step="space">
  <div class="container">
    <div class="cfg-step-head" data-reveal>
      <p class="cfg-step-kicker">{c.progress.stepLabel.replace('{n}', '2')} · {c.progress.steps.space}</p>
      <h2 class="display cfg-step-title">{c.space.heading}</h2>
      <p class="cfg-step-intro">{c.space.intro}</p>
    </div>

    <div class="cfg-space-grid" data-reveal>
      <figure class="sisi-card cfg-plan">
        <div class="cfg-map" style={`--plan-w: ${PLAN_W}; --plan-h: ${PLAN_H};`}>
          <picture>
            <source type="image/avif" srcset={`${PLAN}.avif`} />
            <img src={`${PLAN}.webp`} width={PLAN_W} height={PLAN_H} alt={c.space.planAlt} loading="lazy" decoding="async" />
          </picture>
          <svg class="cfg-map-overlay" viewBox={`0 0 ${PLAN_W} ${PLAN_H}`} aria-hidden="false" role="group" aria-label={c.space.planHint}>
            {MAP_REGIONS.map((region) => (
              <g class="cfg-map-region" role="button" tabindex="0" aria-pressed="false" aria-label={c.space.options[region.key].title} data-map-space={region.key}>
                <polygon points={region.points} />
                <text x={region.labelAt[0]} y={region.labelAt[1]} text-anchor="middle">{region.label}</text>
              </g>
            ))}
          </svg>
        </div>
        <figcaption>{c.space.planHint} {c.space.planCaption}</figcaption>
      </figure>

      <fieldset class="cfg-spaces">
        <legend class="visually-hidden">{c.space.heading}</legend>
        {SPACES.map((key) => (
          <label class="cfg-choice">
            <input type="radio" name="space" value={plSpaces[key].title} data-key={key} data-label={c.space.options[key].title} checked={key === 'unsure'} />
            <span class="cfg-choice-body">
              <span class="cfg-choice-title">{c.space.options[key].title}</span>
              <span class="cfg-choice-sub">{c.space.options[key].body}</span>
            </span>
            <span class="cfg-choice-check" aria-hidden="true">✓</span>
          </label>
        ))}
        <p class="cfg-space-selected">{c.space.selected} <strong data-space-selected>{c.space.options.unsure.title}</strong></p>
        <div class="cfg-actions">
          <a href="#cfg-menu" class="btn-cta cfg-next">{c.buttons.toMenu}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4"/></svg></a>
        </div>
      </fieldset>
    </div>
  </div>
</section>

<style>
  .cfg-space-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 24px; align-items: start; }
  .cfg-plan { margin: 0; padding: 22px 22px 18px; text-align: center; }
  .cfg-map { position: relative; display: inline-block; width: min(100%, 468px); aspect-ratio: var(--plan-w) / var(--plan-h); }
  .cfg-map img { display: block; width: 100%; height: auto; }
  .cfg-map-overlay { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .cfg-map-region { cursor: pointer; outline: none; }
  .cfg-map-region polygon {
    fill: rgba(237,219,194,0); stroke: rgba(237,219,194,0.35); stroke-width: 1.5; stroke-linejoin: round;
    transition: fill 150ms ease, stroke 150ms ease;
  }
  .cfg-map-region text {
    fill: var(--cream); font-family: var(--font-display); font-size: 26px; letter-spacing: 0.04em; text-transform: uppercase;
    paint-order: stroke; stroke: rgba(39,6,15,0.7); stroke-width: 6px; stroke-linejoin: round; pointer-events: none;
  }
  .cfg-map-region:hover polygon { fill: rgba(237,219,194,0.14); stroke: rgba(237,219,194,0.7); }
  .cfg-map-region:focus-visible polygon { stroke: var(--gold); stroke-width: 3; }
  .cfg-map-region.is-selected polygon { fill: rgba(251,210,149,0.16); stroke: var(--gold); stroke-width: 2.5; }
  .cfg-map-region.is-selected text { fill: var(--gold); }
  .cfg-plan figcaption { font-size: 12px; color: var(--text-faint); margin-top: 14px; line-height: 1.5; }
  .cfg-spaces { border: none; margin: 0; padding: 0; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
  .cfg-spaces .cfg-choice-body { padding-right: 44px; }
  .cfg-space-selected { font-size: 13px; color: var(--text-faint); margin-top: 6px; }
  .cfg-space-selected strong { color: var(--cream); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 900px) { .cfg-space-grid { grid-template-columns: 1fr; } }
</style>
