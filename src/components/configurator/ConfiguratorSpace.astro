---
import { SPACES } from '../../data/configurator';
import { type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/t';
import FloorPlan from './FloorPlan.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = useTranslations(locale).configurator;
const plSpaces = useTranslations('pl').configurator.space.options;
// The plan is a hand-drawn vector of the R32 floor (FloorPlan.astro): the
// SiSi club and The Cork restaurant as clean shapes in the brand colours, each
// venue clickable and mirrored to the radios below by the page script.
---

<section id="cfg-space" class="cfg-step" data-cfg-step="space">
  <div class="container">
    <div class="cfg-step-head" data-reveal>
      <p class="cfg-step-kicker">{c.progress.stepLabel.replace('{n}', '1')} · {c.progress.steps.space}</p>
      <h2 class="display cfg-step-title">{c.space.heading}</h2>
      <p class="cfg-step-intro">{c.space.intro}</p>
    </div>

    <div class="cfg-space-grid" data-reveal>
      <figure class="sisi-card cfg-plan">
        <div class="cfg-map">
          <FloorPlan labels={{ sisi: c.space.options.sisi.title, cork: c.space.options.cork.title, shared: c.space.shared }} hint={c.space.planHint} />
        </div>
        <figcaption>{c.space.planHint} {c.space.planCaption}</figcaption>
      </figure>

      <fieldset class="cfg-spaces">
        <legend class="visually-hidden">{c.space.heading}</legend>
        <div class="cfg-spaces-grid">
          {SPACES.map((key) => (
            <label class="cfg-choice">
              <input type="radio" name="space" value={plSpaces[key].title} data-key={key} data-label={c.space.options[key].title} checked={key === 'unsure'} />
              <span class="cfg-choice-body">
                <span class="cfg-choice-title">{c.space.options[key].title}</span>
                <span class="cfg-choice-sub">{c.space.options[key].body}</span>
              </span>
              <span class="cfg-choice-check" aria-hidden="true">✓</span>
            </label>
          ))}
        </div>
        <p class="cfg-space-selected">{c.space.selected} <strong data-space-selected>{c.space.options.unsure.title}</strong></p>
        <div class="cfg-actions">
          <a href="#cfg-details" class="btn-cta cfg-next">{c.buttons.toDetails}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4"/></svg></a>
        </div>
      </fieldset>
    </div>
  </div>
</section>

<style>
  .cfg-space-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 20px; align-items: start; }
  .cfg-plan { margin: 0; padding: 18px 18px 14px; text-align: center; }
  .cfg-map { display: inline-block; width: min(100%, 400px); }
  .cfg-plan figcaption { font-size: 12px; color: var(--text-faint); margin-top: 10px; line-height: 1.5; }
  .cfg-spaces { border: none; margin: 0; padding: 0; min-width: 0; }
  .cfg-spaces-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .cfg-space-selected { font-size: 13px; color: var(--text-faint); margin-top: 12px; }
  .cfg-space-selected strong { color: var(--cream); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 900px) { .cfg-space-grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .cfg-spaces-grid { grid-template-columns: 1fr; } }
</style>
