---
import { SPACES } from '../../data/configurator';
import { ICONS as DRINK_ICONS } from '../../data/bar-menu';
import { UI_ICONS } from '../../data/ui-icons';
import { type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/t';
import FloorPlan from './FloorPlan.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = useTranslations(locale).configurator;
const plSpaces = useTranslations('pl').configurator.space.options;
// The plan is a hand-drawn vector of the R32 floor (FloorPlan.astro): the
// SiSi club and The Cork restaurant as clean shapes in the brand colours, each
// venue clickable and mirrored to the radios below by the page script.
const SPACE_ICONS: Record<string, string> = {
  sisi: DRINK_ICONS.martini,
  cork: UI_ICONS.utensils,
  r32: '<path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-5h6v5"/><path d="M9 10h.01M15 10h.01M9 14h.01M15 14h.01"/>',
  unsure: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.4-1 1-1 1.7"/><path d="M12 17h.01"/>',
};
---

<section id="cfg-space" class="cfg-step" data-cfg-step="space">
  <div class="container">
    <div class="cfg-step-head" data-reveal>
      <h2 class="display cfg-step-title">{c.space.heading}</h2>
    </div>

    <div class="cfg-space-grid" data-reveal>
      <figure class="sisi-card cfg-plan">
        <div class="cfg-map">
          <FloorPlan labels={{ sisi: c.space.options.sisi.title, cork: c.space.options.cork.title, shared: c.space.shared }} hint={c.space.planHint} />
        </div>
        <figcaption>{c.space.planHint}</figcaption>
      </figure>

      <fieldset class="cfg-spaces">
        <legend class="visually-hidden">{c.space.heading}</legend>
        <div class="cfg-spaces-grid">
          {SPACES.map((key) => (
            <label class="cfg-choice">
              <input type="radio" name="space" value={plSpaces[key].title} data-key={key} data-label={c.space.options[key].title} />
              <span class="cfg-choice-body">
                <svg class="cfg-space-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={SPACE_ICONS[key]} />
                <span class="cfg-choice-title">{c.space.options[key].title}</span>
                <span class="cfg-choice-sub">{c.space.options[key].body}</span>
              </span>
              <span class="cfg-choice-check" aria-hidden="true">✓</span>
            </label>
          ))}
        </div>
        <p class="cfg-space-selected">{c.space.selected} <strong data-space-selected>—</strong></p>
        <div class="cfg-actions" data-step-actions>
          <a href="#cfg-details" class="btn-cta cfg-next">{c.buttons.toDetails}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4"/></svg></a>
        </div>
      </fieldset>
    </div>
  </div>
</section>

<style>
  .cfg-space-grid { display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr); gap: 20px; align-items: stretch; }
  .cfg-plan { margin: 0; padding: 16px 16px 12px; text-align: center; display: flex; flex-direction: column; justify-content: center; }
  .cfg-map { display: inline-block; width: min(100%, 256px); margin: 0 auto; }
  .cfg-plan figcaption { font-size: 12px; color: var(--text-faint); margin-top: 10px; line-height: 1.5; }
  .cfg-spaces { border: none; margin: 0; padding: 0; min-width: 0; display: flex; flex-direction: column; }
  .cfg-spaces-grid { flex: 1; display: grid; grid-template-columns: 1fr 1fr; grid-auto-rows: 1fr; gap: 12px; }
  .cfg-spaces-grid .cfg-choice-body { padding: 20px 40px 20px 20px; justify-content: flex-end; gap: 6px; }
  .cfg-spaces-grid .cfg-choice-title { font-family: var(--font-display); font-weight: 400; font-size: 1.15rem; text-transform: uppercase; letter-spacing: 0.03em; }
  .cfg-spaces-grid .cfg-choice-sub { font-size: 12.5px; }
  .cfg-space-icon { width: 28px; height: 28px; margin-bottom: auto; fill: none; stroke: var(--gold); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .cfg-space-selected { font-size: 13px; color: var(--text-faint); margin-top: 12px; }
  .cfg-space-selected strong { color: var(--cream); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  /* Phones: the choices come first, the plan below them. */
  @media (max-width: 900px) { .cfg-space-grid { grid-template-columns: 1fr; } .cfg-plan { order: 2; } .cfg-spaces-grid .cfg-choice-body { min-height: 110px; } }
  @media (max-width: 520px) { .cfg-spaces-grid { grid-template-columns: 1fr; } .cfg-spaces-grid .cfg-choice-body { min-height: 0; } }
</style>
