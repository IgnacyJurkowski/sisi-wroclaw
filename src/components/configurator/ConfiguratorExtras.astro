---
import { EXTRAS } from '../../data/configurator';
import { type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/t';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = useTranslations(locale).configurator;
const plExtras = useTranslations('pl').configurator.extras.items;
const ICONS = {
  exclusive: '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  music: '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>',
  screens: '<rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8m-4-4v4"/>',
  catering: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>',
} as const;
---

<section id="cfg-extras" class="cfg-step" data-cfg-step="extras">
  <div class="container">
    <div class="cfg-step-head" data-reveal>
      <p class="cfg-step-kicker">{c.progress.stepLabel.replace('{n}', '4')} · {c.progress.steps.extras}</p>
      <h2 class="display cfg-step-title">{c.extras.heading}</h2>
      <p class="cfg-step-intro">{c.extras.intro}</p>
    </div>

    <fieldset class="cfg-extras" data-reveal>
      <legend class="visually-hidden">{c.extras.heading}</legend>
      <div class="cfg-extras-grid">
        {EXTRAS.map((key) => (
          <label class="cfg-choice">
            <input type="checkbox" name="extras" value={plExtras[key].title} data-key={key} data-label={c.extras.items[key].title} />
            <span class="cfg-choice-body cfg-extra">
              <svg class="cfg-extra-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[key]} />
              <span class="cfg-choice-title">{c.extras.items[key].title}</span>
              <span class="cfg-choice-sub">{c.extras.items[key].body}</span>
              <span class="cfg-extra-quoted">{c.extras.quoted}</span>
            </span>
            <span class="cfg-choice-check" aria-hidden="true">✓</span>
          </label>
        ))}
      </div>
      <div class="cfg-actions">
        <a href="#cfg-summary" class="btn-cta cfg-next">{c.buttons.toSummary}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4"/></svg></a>
      </div>
    </fieldset>
  </div>
</section>

<style>
  .cfg-extras { border: none; margin: 0; padding: 0; min-width: 0; }
  .cfg-extras-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .cfg-extra { padding: 22px 20px 18px; }
  .cfg-extra-icon { width: 24px; height: 24px; margin-bottom: 10px; fill: none; stroke: var(--gold); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .cfg-extra-quoted { margin-top: auto; padding-top: 12px; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-mute); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 900px) { .cfg-extras-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .cfg-extras-grid { grid-template-columns: 1fr; } }
</style>
