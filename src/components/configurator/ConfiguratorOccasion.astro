---
import { OCCASIONS } from '../../data/configurator';
import { type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/t';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = useTranslations(locale).configurator;
// Submitted option values are the Polish labels so notification emails read in
// Polish whichever language the visitor used (see PrivateEventsEnquiryForm).
const plOccasions = useTranslations('pl').configurator.occasion.options;
const ICONS: Record<string, string> = {
  birthday: '<path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8"/><path d="M4 16c1.5 0 1.5-1 3-1s1.5 1 3 1 1.5-1 3-1 1.5 1 3 1 1.5-1 3-1"/><path d="M2 21h20"/><path d="M7 8v3m5-3v3m5-3v3"/><path d="M7 4h.01M12 4h.01M17 4h.01"/>',
  anniversary: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
  celebration: '<path d="M8 22h8"/><path d="M12 15v7"/><path d="M12 15a5 5 0 0 0 5-5V3H7v7a5 5 0 0 0 5 5Z"/><path d="M8.5 7.5c1 .8 2.2.6 3.5-.5s2.5-1.3 3.5-.5"/>',
  corporate: '<rect width="20" height="14" x="2" y="7" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><path d="M2 13h20"/>',
  other: '<path d="M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6 2.1 2.1m0-12.8-2.1 2.1M7.7 16.3l-2.1 2.1"/><circle cx="12" cy="12" r="3"/>',
};
---

<section id="cfg-occasion" class="cfg-step" data-cfg-step="occasion">
  <div class="container">
    <div class="cfg-step-head" data-reveal>
      <h2 class="display cfg-step-title">{c.occasion.heading}</h2>
    </div>

    <fieldset class="cfg-occasion-tiles" data-reveal>
      <legend class="visually-hidden">{c.occasion.heading}</legend>
      {OCCASIONS.map((key) => (
        <label class="cfg-choice cfg-occasion-tile">
          <input type="radio" name="occasion" value={plOccasions[key]} data-key={key} data-label={c.occasion.options[key]} />
          <span class="cfg-choice-body cfg-occasion-body">
            <svg class="cfg-occasion-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[key]} />
            <span class="cfg-choice-title">{c.occasion.options[key]}</span>
          </span>
          <span class="cfg-choice-check" aria-hidden="true">✓</span>
        </label>
      ))}
    </fieldset>
    <p class="cfg-notice cfg-block" data-step-block="occasion" role="alert" hidden>{c.wizard.blocked.occasion}</p>

    <div class="cfg-actions" data-step-actions>
      <a href="#cfg-space" class="btn-cta cfg-next">{c.buttons.toSpace}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4"/></svg></a>
    </div>
  </div>
</section>

<style>
  .cfg-occasion-tiles { border: none; margin: 0; padding: 0; min-width: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .cfg-occasion-body { padding: 26px 20px 22px; gap: 6px; align-items: flex-start; justify-content: flex-end; min-height: 200px; }
  .cfg-occasion-icon { width: 30px; height: 30px; margin-bottom: auto; fill: none; stroke: var(--gold); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .cfg-occasion-tile .cfg-choice-title { font-family: var(--font-display); font-weight: 400; font-size: 1.15rem; text-transform: uppercase; letter-spacing: 0.03em; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 600px) { .cfg-occasion-tiles { grid-template-columns: 1fr 1fr; } .cfg-occasion-body { min-height: 120px; padding: 18px 16px 16px; } }
</style>
