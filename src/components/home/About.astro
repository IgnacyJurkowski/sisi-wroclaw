---
import { type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/t';
import { variants, CARD_WIDTHS } from '../../lib/img';
import { homeNight } from '../../data/home-night';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const night = homeNight[locale];
const image = '/framerusercontent.com/images/RMGSDUbOPnta4fZZQKL5BcnP3Pw.webp';
const imageSet = `${variants(image, CARD_WIDTHS).webp}, ${image} 900w`;
const imageSizes = '(min-width: 1024px) 39vw, (min-width: 760px) 52vw, calc(100vw - 64px)';
---

<section id="ewolucja-onas" class="about" aria-labelledby="about-title">
  <div class="container about-head" data-reveal>
    <h2 id="about-title" class="display about-title">{t.about.title}</h2>
    <p class="about-intro">{night.intro}</p>
  </div>

  <div class="container about-story">
    <figure class="about-live">
      <img
        src={image}
        srcset={imageSet}
        sizes={imageSizes}
        alt={night.imageAlt}
        width="900"
        height="600"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <ol class="night-phases">
      {night.phases.map((phase) => (
        <li class="night-phase">
          <div>
            <h3 class="display phase-title">{phase.title}</h3>
            <p>{phase.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .about { padding: 96px 0 80px; }
  .about-title {
    max-width: 880px;
    margin: 12px 0 20px;
    font-size: clamp(2.1rem, 4.5vw, 3.5rem);
    text-transform: uppercase;
    line-height: 1.04;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .about-intro {
    max-width: 660px;
    color: var(--text-dim);
    font-size: 16px;
    line-height: 1.75;
  }
  .about-story {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(28px, 3.5vw, 56px);
    margin-top: 38px;
  }
  .about-live { min-width: 0; margin: 0; }
  .about-live img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 56% center;
    border-radius: 12px;
  }
  .night-phases { list-style: none; margin: 0; padding: 0; }
  .night-phase {
    padding: 23px 0;
    border-top: 1px solid rgba(237, 219, 194, 0.18);
  }
  .night-phase:first-child { padding-top: 0; border-top: 0; }
  .night-phase:last-child { padding-bottom: 0; }
  .phase-title {
    margin: 0 0 9px;
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    line-height: 1.16;
  }
  .night-phase p {
    margin: 0;
    color: var(--text-dim);
    font-size: 14px;
    line-height: 1.7;
  }
  @media (max-width: 759px) {
    .about { padding: 64px 0 48px; }
    .about-title { font-size: clamp(2rem, 7.7vw, 3rem); }
    .about-intro { font-size: 14px; }
    .about-story { grid-template-columns: 1fr; gap: 26px; margin-top: 28px; }
    .about-live img { aspect-ratio: 3 / 2; border-radius: 10px; }
    .night-phase { padding: 19px 0; }
    .phase-title { margin-bottom: 6px; font-size: 1.4rem; }
    .night-phase p { font-size: 13px; }
  }
</style>
