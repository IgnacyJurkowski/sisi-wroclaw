---
import { type Locale } from '../../i18n/config';
import { localizedPath } from '../../i18n/routes';
import { useTranslations } from '../../i18n/t';
import { koktajle, mocktails, WINES, DRYNESS, localizeDesc, ICONS, type Item } from '../../data/bar-menu';
import { SECTIONS, ICONS as FOOD_ICONS } from '../../data/food-menu';
import { HOME_MENU } from '../../data/home-menu';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const copy = HOME_MENU[locale];
const menuHref = localizedPath('menu', locale);
type PreviewItem = { name: string; desc?: string; prices: { portion?: string; amount: string }[] };
function pick<T>(items: T[], names: string[], name: (item: T) => string): T[] {
  return names.map((wanted) => {
    const item = items.find((entry) => name(entry) === wanted);
    if (!item) throw new Error(`Homepage menu selection missing: ${wanted}`);
    return item;
  });
}
const drink = (item: Item): PreviewItem => ({
  name: item.name, desc: item.desc ? localizeDesc(item.desc, locale) : undefined,
  prices: [{ portion: item.vol, amount: item.price }],
});
const wines: PreviewItem[] = pick(WINES, ['Halka', 'Triada', 'Chardonnay Barrique'], (w) => w.name).map((w) => ({
  name: [w.name, w.vintage].filter(Boolean).join(' '),
  desc: [w.winery, w.dryness && DRYNESS[w.dryness][locale]].filter(Boolean).join(' · '),
  prices: [...(w.glassPrice ? [{ portion: '150 ml', amount: w.glassPrice }] : []), { portion: '750 ml', amount: w.bottlePrice }],
}));
const food: PreviewItem[] = pick(SECTIONS.flatMap((s) => s.dishes), ['Ostrygi', 'Etażera Sisi', 'Sery Corka'], (d) => d.name.pl).map((d) => ({
  name: d.name[locale], desc: d.desc?.[locale],
  prices: [{ portion: d.tiers[0].qty?.[locale], amount: d.tiers[0].price }],
}));
const tabs = [
  { title: t.menuPage.sections.cocktails, icon: ICONS.martini, anchor: 'cocktails', items: pick(koktajle, ['Hugo Spritz', 'Porn Star Martini', 'Negroni'], (i) => i.name).map(drink) },
  { title: t.menuPage.sections.nonAlcoholic, icon: ICONS.leaf, anchor: 'non-alcoholic', items: mocktails.slice(0, 3).map(drink) },
  { title: t.menuPage.sections.wines, icon: ICONS.wine, anchor: 'wines', items: wines },
  { title: 'Night Menu', icon: FOOD_ICONS.utensils, anchor: 'food', items: food },
];
---

<section id="menu" class="menu-teaser" aria-labelledby="home-menu-title">
  <div class="container">
    <header class="mt-heading" data-reveal>
      <h2 id="home-menu-title" class="display mt-title">{t.menuPage.label}</h2>
      <p>{copy.intro}</p>
    </header>
    <div class="mt-layout">
      <figure class="mt-photo">
        <img src="/images/menu/bar-cocktails.webp" alt={copy.photoAlt} width="1200" height="675" loading="lazy" />
        <figcaption><span class="display">{copy.photoTitle}</span><span>{copy.photoCaption}</span></figcaption>
      </figure>
      <div class="mt-menu">
        <div class="mt-tabs" role="tablist" aria-label={t.menuPage.label}>
          <span class="mt-tab-indicator" aria-hidden="true"></span>
          {tabs.map((tab, i) => (
            <button type="button" class:list={['mt-tab', { 'is-active': i === 0 }]} role="tab"
              id={`mt-tab-${i}`} aria-controls={`mt-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1} data-mt-tab={i}>
              <span class="mt-tab-icon" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={tab.icon} /></span>
              <span class="mt-tab-label">{tab.title}</span>
            </button>
          ))}
        </div>
        <div class="mt-panels">
          {tabs.map((tab, i) => (
            <div class="mt-panel" role="tabpanel" id={`mt-panel-${i}`} aria-labelledby={`mt-tab-${i}`}
              tabindex="0" data-mt-panel={i} hidden={i !== 0}>
              <ul class="mt-items">
                {tab.items.map((item) => (
                  <li class="mt-item">
                    <div class="mt-item-copy"><h3>{item.name}</h3>{item.desc && <p>{item.desc}</p>}</div>
                    <div class="mt-prices">{item.prices.map((price) => (
                      <div class="mt-price">{price.portion && <span>{price.portion}</span>}<strong>{price.amount}</strong></div>
                    ))}</div>
                  </li>
                ))}
              </ul>
              <a class="mt-category-link" href={`${menuHref}#${tab.anchor}`}>{copy.links[i]}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
            </div>
          ))}
        </div>
        <div class="mt-cta"><a href={menuHref} class="btn-cta">{t.buttons.seeFullMenu}</a></div>
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.getElementById('menu');
  if (section) {
    const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-mt-tab]'));
    const panels = Array.from(section.querySelectorAll<HTMLElement>('[data-mt-panel]'));
    const tabList = section.querySelector<HTMLElement>('.mt-tabs')!;
    const indicator = section.querySelector<HTMLElement>('.mt-tab-indicator')!;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let panelAnimation: Animation | undefined;

    const moveIndicator = () => {
      const activeTab = tabs.find((tab) => tab.getAttribute('aria-selected') === 'true');
      if (!activeTab) return;
      indicator.style.width = `${activeTab.offsetWidth}px`;
      indicator.style.transform = `translateX(${activeTab.offsetLeft}px)`;
    };
    moveIndicator();
    // Set the starting position before enabling movement between selections.
    requestAnimationFrame(() => requestAnimationFrame(() => tabList.classList.add('has-indicator')));
    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(moveIndicator).observe(tabList);
    } else {
      window.addEventListener('resize', moveIndicator, { passive: true });
    }
    document.fonts.ready.then(moveIndicator);

    const select = (id: string) => {
      const previousIndex = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
      const nextIndex = tabs.findIndex((tab) => tab.dataset.mtTab === id);
      if (previousIndex === nextIndex) return;
      panelAnimation?.cancel();
      tabs.forEach((tab) => {
        const on = tab.dataset.mtTab === id;
        tab.classList.toggle('is-active', on);
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.mtPanel !== id;
      });
      moveIndicator();
      const nextPanel = panels[nextIndex];
      if (nextPanel && !reducedMotion.matches && typeof nextPanel.animate === 'function') {
        panelAnimation = nextPanel.querySelector('.mt-items')!.animate([
          { opacity: 0, transform: `translate(${nextIndex > previousIndex ? 12 : -12}px, 6px)` },
          { opacity: 1, transform: 'translate(0, 0)' },
        ], { duration: 340, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
      }
    };

    const onMotionChange = () => {
      if (reducedMotion.matches) panelAnimation?.cancel();
    };
    if (typeof reducedMotion.addEventListener === 'function') {
      reducedMotion.addEventListener('change', onMotionChange);
    } else {
      reducedMotion.addListener(onMotionChange);
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => select(tab.dataset.mtTab!));
    });

    // Keep focus and selection together for the ARIA tablist keyboard pattern.
    section.querySelector('.mt-tabs')?.addEventListener('keydown', (e) => {
      const event = e as KeyboardEvent;
      if (!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const current = tabs.findIndex((t) => t.classList.contains('is-active'));
      const step = event.key === 'ArrowRight' ? 1 : tabs.length - 1;
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (current + step) % tabs.length;
      select(tabs[next].dataset.mtTab!);
      tabs[next].focus();
    });
  }
</script>

<style>
  .menu-teaser { padding: 88px 0; scroll-margin-top: 84px; }
  .mt-heading { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 36px; }
  .mt-title { font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1; }
  .mt-heading p { max-width: 350px; font-size: 14px; line-height: 1.7; color: var(--text-dim); }
  .mt-layout { display: grid; grid-template-columns: minmax(0, .78fr) minmax(0, 1.22fr); gap: clamp(28px, 4vw, 56px); align-items: stretch; }
  .mt-photo { position: relative; min-height: 470px; overflow: hidden; border-radius: 12px; }
  .mt-photo img { width: 100%; height: 100%; position: absolute; inset: 0; object-fit: cover; object-position: 62% center; }
  .mt-photo figcaption { position: absolute; inset: auto 0 0; padding: 60px 28px 28px; background: linear-gradient(transparent, rgba(22, 4, 10, .92)); }
  .mt-photo figcaption span { display: block; }
  .mt-photo .display { font-size: clamp(26px, 2.8vw, 38px); line-height: 1.1; margin-bottom: 8px; }
  .mt-photo figcaption span:last-child { font-size: 12px; line-height: 1.6; }
  .mt-menu { min-width: 0; padding-top: 2px; }
  .mt-tabs { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-bottom: 1px solid var(--line); gap: 4px; }
  .mt-tab { background: none; border: none; cursor: pointer; padding: 6px 2px 17px; display: flex; flex-direction: column; align-items: center; gap: 10px; color: var(--text-mute); transition: color 200ms ease; font: inherit; }
  .mt-tab:hover, .mt-tab.is-active { color: var(--cream); }
  .mt-tab-label { font-size: 12px; font-weight: 500; line-height: 1.4; min-height: 2.8em; display: flex; align-items: center; text-align: center; }
  .mt-tab-icon { height: 28px; width: 28px; color: var(--gold); transition: transform 360ms cubic-bezier(.22,1,.36,1); }
  .mt-tab-icon svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .mt-tab.is-active .mt-tab-icon { transform: translateY(-3px); }
  .mt-tab-indicator { position: absolute; left: 0; bottom: -1px; height: 2px; width: 0; background: var(--cream); opacity: 0; pointer-events: none; }
  .has-indicator .mt-tab-indicator { opacity: 1; transition: transform 420ms cubic-bezier(.22,1,.36,1), width 420ms cubic-bezier(.22,1,.36,1), opacity 200ms ease; }
  .mt-panels { margin-top: 8px; }
  .mt-panel[hidden] { display: none; }
  .mt-item { display: flex; justify-content: space-between; gap: 18px; padding: 21px 0; border-bottom: 1px solid var(--line); }
  .mt-item-copy { min-width: 0; }
  .mt-item h3 { font-size: 17px; line-height: 1.35; font-weight: 500; letter-spacing: -.02em; }
  .mt-item p { color: var(--text-dim); font-size: 12px; line-height: 1.7; margin-top: 7px; white-space: pre-line; }
  .mt-prices { flex-shrink: 0; }
  .mt-price { display: flex; flex-direction: column; align-items: end; gap: 5px; margin-bottom: 9px; }
  .mt-price span { font-size: 10px; line-height: 1.35; color: var(--text-dim); white-space: nowrap; }
  .mt-price strong { font-size: 16px; font-weight: 500; white-space: nowrap; }
  .mt-category-link { display: flex; width: fit-content; align-items: center; gap: 12px; min-height: 44px; font-size: 12px; margin-top: 11px; text-decoration: underline; text-underline-offset: 5px; }
  .mt-category-link svg { width: 18px; height: 18px; flex-shrink: 0; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .mt-cta { margin-top: 20px; }
  .mt-tab:focus-visible, .mt-panel:focus-visible, .mt-category-link:focus-visible { outline: 2px solid var(--cream); outline-offset: 4px; border-radius: 4px; }
  @media (max-width: 1100px) and (min-width: 761px) { .mt-layout { grid-template-columns: minmax(0, .65fr) minmax(0, 1.35fr); gap: 26px; } }
  @media (max-width: 760px) {
    .menu-teaser { padding: 64px 0; }
    .mt-heading { display: block; margin-bottom: 25px; }
    .mt-heading p { margin-top: 18px; max-width: 440px; }
    .mt-layout { grid-template-columns: minmax(0, 1fr); gap: 26px; }
    .mt-photo { min-height: 0; aspect-ratio: 2 / 1; }
    .mt-photo img { object-position: 50% 64%; }
    .mt-photo figcaption { padding: 45px 20px 18px; }
    .mt-photo figcaption span:last-child { display: none; }
    .mt-photo .display { font-size: 26px; margin: 0; }
    .mt-tab-label { font-size: 12px; }
    .mt-item { padding: 19px 0; }
    .mt-item h3 { font-size: 16px; }
    .mt-item p { font-size: 12px; }
    .mt-cta { margin-top: 16px; }
  }
  @media (prefers-reduced-motion: reduce) { .mt-tab, .mt-tab-icon, .has-indicator .mt-tab-indicator { transition: none; } .mt-tab.is-active .mt-tab-icon { transform: none; } }
</style>
